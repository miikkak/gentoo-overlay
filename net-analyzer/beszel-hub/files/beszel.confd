# /etc/conf.d/beszel
#
# Defaults live in the init script.

# Required: public URL the hub is reachable at.
#BESZEL_APP_URL="https://beszel.example.com"

#BESZEL_LISTEN="127.0.0.1:8090"
#BESZEL_DATA_DIR="/var/lib/beszel"
#BESZEL_LOG_DIR="/var/log/beszel"
#BESZEL_USER="beszel"
#BESZEL_GROUP="beszel"

# Optional: ping this URL periodically (e.g. Healthchecks.io). The URL is a
# bearer secret; keep this file readable by root only.
#BESZEL_HEARTBEAT_URL=""
#BESZEL_HEARTBEAT_INTERVAL="60"
#BESZEL_HEARTBEAT_METHOD="POST"
